---
interface Props {
  title: string;
}

const { title } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Bookshelf</title>
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  </head>
  <body class="flex flex-col min-h-screen">
    <header class="bg-stone-800 text-white shadow-md">
      <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
        <a href={base} class="text-xl font-bold tracking-wide hover:text-stone-300 transition-colors">
          Bookshelf
        </a>
        <nav class="flex gap-6 text-sm">
          <a href={base} class="hover:text-stone-300 transition-colors">読了本</a>
          <a href={`${base}want-to-read/`} class="hover:text-stone-300 transition-colors">読みたい</a>
          <a href={`${base}stats/`} class="hover:text-stone-300 transition-colors">統計</a>
        </nav>
      </div>
    </header>

    <main class="flex-1 max-w-6xl mx-auto px-4 py-8 w-full">
      <slot />
    </main>

    <footer class="bg-stone-100 border-t border-stone-200 text-stone-500 text-center text-sm py-6">
      <p>&copy; {new Date().getFullYear()} Bookshelf</p>
    </footer>
  </body>
</html>
