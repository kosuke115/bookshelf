---
import Layout from "../../layouts/Layout.astro";
import StarRating from "../../components/StarRating.astro";
import TagList from "../../components/TagList.astro";
import type { Book } from "../../types/book";

export async function getStaticPaths() {
  const books: Book[] = (await import("../../data/books.json")).default;
  return books.map((book) => ({
    params: { id: book.id },
    props: { book },
  }));
}

const { book } = Astro.props;
const base = import.meta.env.BASE_URL;

function formatDate(dateStr: string): string {
  if (!dateStr) return "";
  const [y, m, d] = dateStr.split("-");
  return `${y}年${parseInt(m)}月${parseInt(d)}日`;
}
---

<Layout title={book.title}>
  <div class="max-w-3xl mx-auto" data-pagefind-body>
    <a href={base} class="text-stone-500 hover:text-stone-700 text-sm mb-6 inline-block">&larr; 一覧に戻る</a>

    <div class="bg-white rounded-lg shadow-sm p-6 md:p-8">
      <div class="md:flex gap-8">
        <!-- Cover -->
        <div class="md:w-48 flex-shrink-0 mb-6 md:mb-0">
          <div class="aspect-[2/3] bg-stone-200 rounded-lg overflow-hidden">
            <img
              src={`${base}${book.coverImage.replace(/^\//, "")}`}
              alt={book.title}
              class="w-full h-full object-cover"
              onerror="this.style.display='none';this.parentElement.classList.add('flex','items-center','justify-center');this.parentElement.innerHTML='<span class=\\'text-stone-400 text-6xl\\'>📖</span>'"
            />
          </div>
        </div>

        <!-- Details -->
        <div class="flex-1">
          <h1 class="text-2xl font-bold mb-2" data-pagefind-meta="title">{book.title}</h1>
          <p class="text-lg text-stone-600 mb-4" data-pagefind-meta="author">{book.author}</p>

          {book.status === "read" && (
            <div class="mb-4">
              <StarRating rating={book.rating} size="lg" />
            </div>
          )}

          <dl class="grid grid-cols-2 gap-x-4 gap-y-2 text-sm mb-6">
            <dt class="text-stone-500">出版社</dt>
            <dd>{book.publisher}</dd>

            <dt class="text-stone-500">初版発行日</dt>
            <dd>{formatDate(book.firstEditionDate)}</dd>

            <dt class="text-stone-500">ページ数</dt>
            <dd>{book.pageCount}ページ</dd>

            <dt class="text-stone-500">ジャンル</dt>
            <dd>{book.genre}</dd>

            {book.readDate && (
              <>
                <dt class="text-stone-500">読了日</dt>
                <dd>{formatDate(book.readDate)}</dd>
              </>
            )}
          </dl>

          <div class="mb-6">
            <TagList tags={book.tags} />
          </div>
        </div>
      </div>

      <!-- Memo -->
      {book.memo && (
        <div class="mt-8 pt-6 border-t border-stone-200">
          <h2 class="text-lg font-semibold mb-3">感想・レビュー</h2>
          <p class="text-stone-700 leading-relaxed whitespace-pre-wrap">{book.memo}</p>
        </div>
      )}
    </div>
  </div>
</Layout>
