---
import Layout from "../layouts/Layout.astro";
import BookCard from "../components/BookCard.astro";
import GenreFilter from "../components/GenreFilter.astro";
import type { Book } from "../types/book";

const books: Book[] = (await import("../data/books.json")).default;
const readBooks = books.filter((b) => b.status === "read");
const genres = [...new Set(readBooks.map((b) => b.genre))].sort();
---

<Layout title="読了本一覧">
  <!-- Pagefind search -->
  <div class="mb-6">
    <div id="search" class="pagefind-search"></div>
  </div>

  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold">読了本</h1>
    <span class="text-stone-400 text-sm">{readBooks.length} 冊</span>
  </div>

  <div class="mb-6">
    <GenreFilter genres={genres} />
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4" id="book-grid">
    {readBooks.map((book) => (
      <div data-genre-card={book.genre}>
        <BookCard book={book} />
      </div>
    ))}
  </div>

  {readBooks.length === 0 && (
    <p class="text-stone-400 text-center py-12">まだ読了した本がありません</p>
  )}

  <link href={`${import.meta.env.BASE_URL}pagefind/pagefind-ui.css`} rel="stylesheet" />
  <script is:inline define:vars={{ base: import.meta.env.BASE_URL }}>
    window.addEventListener('DOMContentLoaded', () => {
      const script = document.createElement('script');
      script.src = base + 'pagefind/pagefind-ui.js';
      script.onload = () => {
        new PagefindUI({
          element: '#search',
          showSubResults: true,
          bundlePath: base + 'pagefind/',
        });
      };
      document.head.appendChild(script);
    });
  </script>
</Layout>
